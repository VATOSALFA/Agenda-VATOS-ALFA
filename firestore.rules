rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isGeneralAdmin() || (
        isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.auth.token.get('email', '') != 'app_client_sync@vatosalfa.com' &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
      );
    }

    function isNotAppAnonymousSync() {
      return isStaff();
    }

    function isGeneralAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'JxK6BLZPOBcBpjnuVZPsgmIHbZ12' ||
        request.auth.token.email == 'vatosalfa@gmail.com'
      );
    }

    function hasAdminRole() {
      let uDoc = get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
      return uDoc != null && uDoc.data != null && (
        uDoc.data.get('role', '') in ['Administrador general', 'Administrador local'] ||
        uDoc.data.get('rol', '') in ['Administrador general', 'Administrador local']
      );
    }

    function isAdmin() {
      return isGeneralAdmin() || (isStaff() && hasAdminRole());
    }

    // Impide que un cliente desde la App Móvil se auto-asigne Alfa Coins, Sellos, Cortes Gratis, Nivel o Exención de Anticipo
    function isSafeClientCreate() {
      return isStaff() || (
        request.resource.data.get('alfaCoins', 0) <= 0 &&
        request.resource.data.get('alfa_coins', 0) <= 0 &&
        request.resource.data.get('puntos', 0) <= 0 &&
        request.resource.data.get('puntos_lealtad', 0) <= 0 &&
        request.resource.data.get('puntosLealtad', 0) <= 0 &&
        request.resource.data.get('cortes_acumulados', 0) <= 0 &&
        request.resource.data.get('cortesAcumulados', 0) <= 0 &&
        request.resource.data.get('corte_gratis_disponible', false) == false &&
        request.resource.data.get('corteGratisDisponible', false) == false &&
        request.resource.data.get('exento_anticipo', false) == false &&
        request.resource.data.get('visitas_pase_alfa', 0) <= 0 &&
        request.resource.data.get('consumo_pase_alfa', 0) <= 0 &&
        request.resource.data.get('visitas_elegibles_historicas', 0) <= 0 &&
        request.resource.data.get('citas_asistidas', 0) <= 0
      );
    }

    // Solo permite al cliente editar datos de perfil / recompensas vistas (nunca saldos, sellos, nivel ni fechas antifraude)
    function isSafeClientUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let alwaysProtectedFields = [
        'exento_anticipo', 'tier',
        'ultimo_canje_cumpleanos_anio', 'ultimo_canje_cumpleanos_folio', 'ultimo_canje_juntos_fecha', 'ultimo_sello_fecha',
        'visitas_totales', 'consumo_total', 'gasto_total', 'consumoTotal',
        'citas_asistidas', 'citasAsistidas', 'referido_por', 'referido_por_id', 'referido_usado',
        'beneficio_referido_usado', 'codigo_referido_usado', 'amigos_referidos'
      ];
      let loyaltyInitFields = [
        'alfaCoins', 'alfa_coins', 'puntos', 'puntos_lealtad', 'puntosLealtad',
        'cortes_acumulados', 'cortesAcumulados',
        'corte_gratis_disponible', 'corteGratisDisponible',
        'nivel', 'visitas_elegibles_historicas', 'visitas_pase_alfa', 'consumo_pase_alfa'
      ];
      let isFirstAppLink = (
        (resource.data.get('fecha_registro_app_iso', '') == '' || resource.data.get('fecha_registro_app_iso', null) == null) &&
        (resource.data.get('fecha_registro_app', '') == '' || resource.data.get('fecha_registro_app', null) == null)
      );
      let loyaltyNotAbused = (
        !changedKeys.hasAny(loyaltyInitFields) ||
        (
          isFirstAppLink &&
          request.resource.data.get('alfaCoins', 0) <= 0 &&
          request.resource.data.get('alfa_coins', 0) <= 0 &&
          request.resource.data.get('puntos', 0) <= resource.data.get('puntos', 0) &&
          request.resource.data.get('puntos_lealtad', 0) <= 0 &&
          request.resource.data.get('puntosLealtad', 0) <= 0 &&
          request.resource.data.get('cortes_acumulados', 0) <= 0 &&
          request.resource.data.get('cortesAcumulados', 0) <= 0 &&
          request.resource.data.get('corte_gratis_disponible', false) == false &&
          request.resource.data.get('corteGratisDisponible', false) == false &&
          request.resource.data.get('visitas_pase_alfa', 0) <= 0 &&
          request.resource.data.get('consumo_pase_alfa', 0) <= 0 &&
          request.resource.data.get('visitas_elegibles_historicas', 0) <= 0 &&
          request.resource.data.get('nivel', 'Alfa Member') == 'Alfa Member'
        )
      );
      let birthNotAbused = (
        !changedKeys.hasAny(['fecha_nacimiento', 'cumpleanos', 'birthDate']) ||
        (
          (resource.data.get('fecha_nacimiento', '') == '' || resource.data.get('fecha_nacimiento', null) == null) &&
          (resource.data.get('cumpleanos', '') == '' || resource.data.get('cumpleanos', null) == null)
        )
      );
      let rewardOnlyCleared = (
        !changedKeys.hasAny(['recompensa_pendiente']) ||
        request.resource.data.get('recompensa_pendiente', null) == null
      );
      return isStaff() || (
        !changedKeys.hasAny(alwaysProtectedFields) &&
        loyaltyNotAbused &&
        birthNotAbused &&
        rewardOnlyCleared
      );
    }

    // ---------------------------------------------------------
    // RULES
    // ---------------------------------------------------------

    // 1. Business Configuration (Public Read for Login/Branding)
    match /empresa/{document=**} {
      allow read: if true;
      allow write: if isNotAppAnonymousSync(); 
    }
    // Private customer feedback subcollection: anyone authenticated can submit, only staff/real users can read/manage
    match /settings/app_movil/opiniones/{opinionId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isNotAppAnonymousSync();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isNotAppAnonymousSync();
    }
    // Proteger credenciales sensibles de Mercado Pago (solo Administrador General; backend usa Admin SDK)
    match /configuracion/mercadopago {
      allow read, write: if isGeneralAdmin();
    }
    match /configuracion/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /locales/{document=**} {
      allow read: if true;
      allow write: if isNotAppAnonymousSync();
    }
    match /ajustes_sitio/{document=**} {
      allow read: if true;
      allow write: if isNotAppAnonymousSync();
    }
    match /promociones/{document=**} {
      allow read: if true;
      allow write: if isNotAppAnonymousSync();
    }
    match /app_avisos/{document=**} {
      allow read: if true;
      allow write: if isNotAppAnonymousSync();
    }
    match /app_promociones/{document=**} {
      allow read: if true;
      allow write: if isNotAppAnonymousSync();
    }
    match /opiniones_app/{document=**} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isNotAppAnonymousSync();
    }

    // 2. User Profiles (Staff & Admin) - Jerarquía estricta
    match /usuarios/{userId} {
      allow read: if isStaff() || isOwner(userId);
      allow create: if isGeneralAdmin() || (
        isAdmin() &&
        !(request.resource.data.get('role', '') in ['Administrador general', 'Administrador local', 'admin']) &&
        !(request.resource.data.get('rol', '') in ['Administrador general', 'Administrador local', 'admin'])
      );
      allow update: if isGeneralAdmin() || (
        isAdmin() &&
        userId != request.auth.uid &&
        !(resource.data.get('role', '') in ['Administrador general', 'Administrador local', 'admin']) &&
        !(resource.data.get('rol', '') in ['Administrador general', 'Administrador local', 'admin']) &&
        !(request.resource.data.get('role', '') in ['Administrador general', 'Administrador local', 'admin']) &&
        !(request.resource.data.get('rol', '') in ['Administrador general', 'Administrador local', 'admin'])
      ) || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'rol', 'permissions', 'status', 'local_id', 'email'
        ])
      );
      allow delete: if (isGeneralAdmin() && userId != request.auth.uid) || (
        isAdmin() &&
        userId != request.auth.uid &&
        !(resource.data.get('role', '') in ['Administrador general', 'Administrador local', 'admin']) &&
        !(resource.data.get('rol', '') in ['Administrador general', 'Administrador local', 'admin'])
      );
    }

    // 3. Professionals (Staff) - Acceso público de lectura para catálogo/agenda
    match /profesionales/{profId} {
      allow read: if true;
      allow write: if isNotAppAnonymousSync();
    }

    // 4. Roles & Permissions
    match /roles/{roleId} {
      allow read: if isStaff();
      allow write: if isGeneralAdmin();
    }

    // 5. Services & Products (Catalog)
    match /servicios/{document=**} { 
      allow read: if true; 
      allow write: if isNotAppAnonymousSync(); 
    }
    
    match /categorias_servicios/{document=**} { 
      allow read: if true; 
      allow write: if isNotAppAnonymousSync(); 
    }
    match /products/{document=**} { 
      allow read: if true;
      allow write: if isNotAppAnonymousSync(); 
    }
    match /productos/{document=**} { 
      allow read: if true;
      allow write: if isNotAppAnonymousSync(); 
    } 
    match /brands/{document=**} { allow read: if true; allow write: if isNotAppAnonymousSync(); }
    match /presentations/{document=**} { allow read: if true; allow write: if isNotAppAnonymousSync(); }
    match /categories/{document=**} { allow read: if true; allow write: if isNotAppAnonymousSync(); }

    // 6. Business Logic (Reservations, Clients, Finance)
    match /reservas/{docId} {
      allow read: if isAuthenticated();
      allow create: if isStaff() || (
        isAuthenticated() &&
        request.resource.data.get('pago_estado', 'Pendiente') != 'Pagado' &&
        request.resource.data.get('pago_estado', 'Pendiente') != 'deposit_paid' &&
        request.resource.data.get('anticipoPagado', 0) == 0 &&
        request.resource.data.get('anticipo_pagado', 0) == 0 &&
        request.resource.data.get('monto_pagado', 0) == 0 &&
        request.resource.data.get('monto_anticipo', 0) == 0 &&
        request.resource.data.get('monto_pagado_real', 0) == 0
      );
      allow update: if isStaff() || (
        isAuthenticated() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'pago_estado', 'anticipoPagado', 'anticipo_pagado', 'total_pagado',
          'monto_pagado', 'monto_pagado_real', 'monto_anticipo',
          'mercado_pago_id', 'venta_id', 'exento_anticipo'
        ])
      );
      allow delete: if isStaff() || (
        isAuthenticated() &&
        resource.data.get('estado', '') == 'Pendiente de pago' &&
        resource.data.get('anticipoPagado', 0) == 0 &&
        resource.data.get('anticipo_pagado', 0) == 0 &&
        resource.data.get('monto_pagado', 0) == 0
      );
    }
    match /reservas_sandbox/{document=**} { allow read, write: if isStaff(); }
    match /bloqueos_horario/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /jornadas_especiales/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /sales/{document=**} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.get('cliente_id', '') == request.auth.uid);
      allow write: if isStaff();
    }
    match /ventas/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /ventas_canceladas/{document=**} { allow read, write: if isStaff(); }

    match /caja/{document=**} { allow read, write: if isStaff(); }
    
    match /clientes/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isSafeClientCreate();
      allow update: if isAuthenticated() && isSafeClientUpdate();
      allow delete: if isStaff();
    }
    match /clients/{document=**} { allow read, write: if isStaff(); } 

    // Canjes de Beneficios (Pase Alfa y Cupones App Móvil) - Lectura autenticada (compatibilidad app instalada), escritura exclusiva Staff
    match /canjes_beneficios/{document=**} { 
      allow read: if isAuthenticated();
      allow write: if isStaff();
    } 

    match /finanzas/{document=**} { allow read, write: if isAdmin(); }
    match /finanzas_mensuales/{document=**} { allow read, write: if isAdmin(); }

    // 7. Communications
    match /conversaciones/{document=**} { allow read, write: if isAuthenticated(); }
    match /conversations/{document=**} { allow read, write: if isStaff(); }
    match /whatsapp_configuraciones/{document=**} { allow read, write: if isStaff(); }

    // 8. Other Business Data (Spanish naming conventions found in code)
    match /terminales/{document=**} { allow read, write: if isStaff(); }
    match /codigos_autorizacion/{document=**} { allow read, write: if isAdmin(); }
    match /codigos_verificacion/{document=**} { allow read, write: if isStaff(); }
    match /egresos/{document=**} { allow read, write: if isStaff(); }
    match /ingresos_manuales/{document=**} { allow read, write: if isStaff(); }
    match /liquidaciones_admin/{document=**} { allow read, write: if isAdmin(); }
    match /cortes_caja/{document=**} { allow read, write: if isStaff(); }
    
    // Product Catalog (Spanish)
    match /categorias_productos/{document=**} { allow read: if true; allow write: if isStaff(); }
    match /formatos_productos/{document=**} { allow read: if true; allow write: if isStaff(); }
    match /marcas_productos/{document=**} { allow read: if true; allow write: if isStaff(); }
    match /movimientos_inventario/{document=**} { allow read, write: if isStaff(); }
    
    // Payments
    match /pagos/{document=**} { allow read, write: if isStaff(); }
    match /audit_logs/{document=**} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if false;
    }
    
    // Work Sessions (Nómina)
    match /sesiones_trabajo/{document=**} { allow read, write: if isStaff(); }
    match /pagos_nomina/{document=**} { allow read, write: if isStaff(); }

    // 9. Janet CEO - Bóveda Exclusiva del Administrador General (Zero-Trust)
    match /ceo_sesiones/{document=**} { allow read, write: if isGeneralAdmin(); }
    match /ceo_memoria/{document=**} { allow read, write: if isGeneralAdmin(); }
    match /ceo_alertas/{document=**} { allow read, write: if isGeneralAdmin(); }
    match /ceo_config/{document=**} { allow read, write: if isGeneralAdmin(); }
    match /ceo_propuestas/{document=**} { allow read, write: if isGeneralAdmin(); }

    // 10. Janet Gerencia - Asistente Operativa de Sucursal (Administrador Local / General)
    match /gerencia_sesiones/{document=**} { allow read, write: if isAdmin(); }
    match /gerencia_recordatorios/{document=**} { allow read, write: if isAdmin(); }
    match /gerencia_propuestas/{document=**} { allow read, write: if isAdmin(); }

    // DENY ALL OTHERS BY DEFAULT
  }
}
